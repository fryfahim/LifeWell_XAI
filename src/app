                          options=[0, 1, 2, 3, 4],
                          value=2,
                          help="0: Very Dissatisfied → 4: Very Satisfied")
    C1 = st.select_slider(" Stress Level (C1)", 
                          options=[0, 1, 2, 3, 4],
