# ---------------------------------------------------------
# LOAD MODEL
# ---------------------------------------------------------
@st.cache_resource
def load_model():
    try:
        return joblib.load("gb_model_7features.pkl")
    except FileNotFoundError:
        st.error("⚠️ Model file not found. Please ensure 'gb_model_7features.pkl' is in the same directory.")
        st.stop()

model = load_model()

# These are the exact features expected by your .pkl file 
FEATURES = ["age", "A2", "B1", "C1", "D1", "E1", "G1"]
FEATURE_NAMES = {
    "age": "Age",
    "A2": "General Health",
    "B1": "Financial Satisfaction",
    "C1": "Stress Level",
    "D1": "Housing Satisfaction",
    "E1": "Social Support",
    "G1": "Community Engagement"
}

# ---------------------------------------------------------
# HEADER
# ---------------------------------------------------------
st.markdown(f"""
