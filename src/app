# ---------------------------------------------------------
# PREDICTION & RESULTS
# ---------------------------------------------------------
if st.button(" Analyze Well-being Score"):
    with st.spinner(" Analyzing your well-being profile..."):
        # Prepare input array
        input_data = np.array([[age, A2, B1, C1, D1, E1, G1]])
        
        prediction = model.predict(input_data)[0]
        probabilities = model.predict_proba(input_data)[0]
        
        st.markdown("<br>", unsafe_allow_html=True)
        
        res_col, exp_col = st.columns([1, 2], gap="large")
        
        with res_col:
            confidence = probabilities[prediction] * 100
            
            if prediction == 1:
                st.markdown(f"""
                    <div class='success-card'>
                        <h2 style='color: white !important; margin: 0;'> SATISFIED</h2>
                        <h1 style='color: white !important; font-size: 3em; margin: 20px 0;'>{confidence:.1f}%</h1>
                        <p style='color: white !important; font-size: 1.1em;'>Confidence Score</p>
                    </div>
                """, unsafe_allow_html=True)
            else:
                st.markdown(f"""
                    <div class='error-card'>
                        <h2 style='color: white !important; margin: 0;'> DISSATISFIED</h2>
                        <h1 style='color: white !important; font-size: 3em; margin: 20px 0;'>{confidence:.1f}%</h1>
                        <p style='color: white !important; font-size: 1.1em;'>Confidence Score</p>
                    </div>
                """, unsafe_allow_html=True)
            
            # Probability distribution
            st.markdown("<br>", unsafe_allow_html=True)
            st.markdown("<div class='metric-card'>", unsafe_allow_html=True)
            st.markdown("### 📊 Probability Distribution")
            col_a, col_b = st.columns(2)
            with col_a:
                st.metric("Dissatisfied", f"{probabilities[0]*100:.1f}%")
            with col_b:
                st.metric("Satisfied", f"{probabilities[1]*100:.1f}%")
            st.markdown("</div>", unsafe_allow_html=True)
                
        with exp_col:
            st.markdown("<div class='metric-card'>", unsafe_allow_html=True)
            st.markdown("### 🔍 Feature Importance Analysis")
            
            # Generate custom bar chart
            importances = model.feature_importances_
            feature_labels = [FEATURE_NAMES[f] for f in FEATURES]
            df_imp = pd.DataFrame({
                'Feature': feature_labels, 
                'Importance': importances
            }).sort_values('Importance', ascending=False)
            
            # Normalize for display (0-100%)
            max_imp = df_imp['Importance'].max()
            
            for _, row in df_imp.iterrows():
                width_pct = (row['Importance'] / max_imp) * 100
                st.markdown(f"""
                    <div class='importance-bar'>
                        <div style='display: flex; justify-content: space-between; margin-bottom: 5px;'>
                            <span style='font-weight: 600;'>{row['Feature']}</span>
                            <span style='color: {accent_color}; font-weight: 600;'>{row['Importance']:.4f}</span>
                        </div>
                        <div style='background-color: rgba(150,150,150,0.2); border-radius: 6px; overflow: hidden;'>
                            <div class='bar-fill' style='width: {width_pct}%;'></div>
                        </div>
                    </div>
                """, unsafe_allow_html=True)
            
            st.markdown("</div>", unsafe_allow_html=True)
        
        # Additional insights
        st.markdown("<br>", unsafe_allow_html=True)
        st.markdown("<div class='metric-card'>", unsafe_allow_html=True)
        st.markdown("### 💡 Your Profile Summary")
        
        input_values = {
            "Age": age,
            "General Health": f"{A2}/4",
            "Financial Satisfaction": f"{B1}/4",
            "Stress Level": f"{C1}/4",
            "Housing Satisfaction": f"{D1}/4",
            "Social Support": f"{E1}/4",
            "Community Engagement": f"{G1}/10"
        }
        
        cols = st.columns(4)
        for idx, (key, value) in enumerate(input_values.items()):
            with cols[idx % 4]:
                st.metric(key, value)
        
        st.markdown("</div>", unsafe_allow_html=True)

